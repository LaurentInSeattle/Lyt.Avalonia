<UserControl 
	x:Class="Lyt.Avalonia.Mvvm.Toasting.ToastView"
	xmlns:vm="clr-namespace:Lyt.Avalonia.Mvvm.Toasting"
	x:DataType="vm:ToastViewModel" 

	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450" d:DesignWidth="800"
	mc:Ignorable="d"

	xmlns:glyphs="clr-namespace:Lyt.Avalonia.Controls.Glyphs;assembly=Lyt.Avalonia.Controls"

	Background="Transparent"
	HorizontalAlignment="Center" VerticalAlignment="Center"
	ZIndex="9999999"
	Margin="60"
	MaxWidth="800"
	>	
	<Grid
		x:Name="OuterGrid"
		Margin ="8"
		HorizontalAlignment="Stretch"
		>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="100"/>
			<ColumnDefinition Width="20"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="120"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="20" />
			<RowDefinition Height="42" />
			<RowDefinition Height="8" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="20" />
		</Grid.RowDefinitions>
		<Border
			x:Name="outerBorder"
			Grid.ColumnSpan="999" Grid.RowSpan="999"
			HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
			Background="Transparent"
			BorderBrush="{StaticResource LightAqua_0_120}"
			BorderThickness="2"
			CornerRadius="8"
			/>
		<Rectangle
			Margin="2"
			Fill="#F0000020"
			Grid.ColumnSpan="999" Grid.RowSpan="999"
			RadiusX="8" RadiusY="8"
			/>
		<PathIcon
			x:Name="Icon"
			Grid.Column="0" Grid.Row="1" Grid.RowSpan="3"
			Data="{Binding IconGeometry}"
			Foreground="{Binding ColorLevel}"
			Width="60" Height="60"
			Margin="0"
			VerticalAlignment="Top"
			>
		</PathIcon>
		<TextBlock
			Grid.Column="2" Grid.Row="1"
			Foreground ="{Binding ColorLevel}"
			Margin="0 0 0 0"
			FontWeight="DemiBold"
			FontSize ="24"
			Text="{Binding Title, FallbackValue=Toast Title}"
			/>
		<TextBlock
			Grid.Column="2" Grid.Row="3"
			Foreground ="{Binding ColorLevel}"
			Text="{Binding Message, FallbackValue=Toast message}"
			FontSize ="22"
			Margin="20 0 0 0"
			TextWrapping="Wrap"
			/>
		<glyphs:GlyphButton
			x:Name="dismissButton"
			Grid.Column="3" Grid.Row="1" Grid.RowSpan="3"
			Style="{StaticResource ToolbarIconButton}"
			Layout="IconTextBelow"
			Behaviour="Tap"
			HorizontalAlignment="Center" VerticalAlignment="Top"
			Width="80" Height="60"
			Margin="4 0 4 0"
			GlyphSource="dismiss"
			Text="{DynamicResource Toast.Dismiss}"
			ButtonBackground="BorderlessRectangle"
			GlyphStrokeThickness="0"
			GlyphAngle="0"
			Command="{Binding OnDismiss}"
			/>
	</Grid>
</UserControl>
